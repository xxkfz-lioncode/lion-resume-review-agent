# ============================================================
# 环境变量模板（可提交仓库）
# 使用方式：复制为 .env 并填写真实值（.env 已被 gitignore，不会提交）
#   cp .env.example .env
# application.yml 通过 spring.config.import 自动加载根目录 .env
# ============================================================

# ---------- MySQL ----------
# 完整 JDBC 连接串（含 host/port/db/字符集参数）
# 本地 IDE 直连用；若通过 docker compose 起 MySQL，宿主机端口见 docker-compose.yml
# （当前宿主机 3306 可能已被本地 MySQL 占用，compose 映射到 3307，此处需同步改为 localhost:3307）
MYSQL_URL=jdbc:mysql://localhost:3306/resume_review?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# 账号 / 密码（必填）
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-mysql-password

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# 无密码可留空
REDIS_PASSWORD=your-redis-password

# ---------- DashScope 千问大模型 ----------
# 阿里云 DashScope API Key；不配置时 LLM 节点进入演示模式（返回模拟数据）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ---------- Milvus 向量库 ----------
# 注释掉该变量（或留空）即关闭向量检索，不影响审查主流程
MILVUS_HOST=127.0.0.1

# ---------- Langfuse 可观测性 ----------
# 自托管 Langfuse 需手动克隆官方仓库并 docker compose up -d，不占用项目主 compose。
# 步骤：git clone https://github.com/langfuse/langfuse.git → cd langfuse
#       编辑 docker-compose.yml 解决端口冲突（minio 9091→9093 / redis 6379→6380）
#       docker compose up -d
# 启动后注册账号 → 建项目 → Settings → API Keys 拿 pk/sk。
#
# 端点写法取决于「后端跑在哪」（路径必须含 /api/public/otel，缺了会 404）：
#   ① 后端跑在宿主机（mvn spring-boot:run）→ http://localhost:3000/api/public/otel/v1/traces
#   ② 后端跑在 docker compose 容器里      → http://host.docker.internal:3000/api/public/otel/v1/traces
#      （docker-compose.yml 已按 ② 配好默认值，所以本行保持注释即可）
#   ③ 改用 Langfuse Cloud                 → https://us.cloud.langfuse.com/api/public/otel/v1/traces
#LANGFUSE_OTLP_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces

# OTLP 认证：Basic Auth = Basic base64(pk-lf-xxx:sk-lf-xxx)
# 生成：
#   命令行：printf '%s' 'pk-lf-xxx:sk-lf-xxx' | base64
#   或测试类：mvn test -Dtest=LangfuseAuthBasicTest -Dlangfuse.pk=pk-lf-xxx -Dlangfuse.sk=sk-lf-xxx
# 前缀 "Basic " 保留，末尾不要换行
# pk / sk 从 Langfuse 控制台 → 项目 Settings → API Keys 获取
LANGFUSE_AUTH_BASIC=Basic base64(public-key:secret-key)
